########################################
# ASPLOS Camera-Ready Style (Arial + Bold Ticks)
########################################

### Global font settings
font.size        : 9

# Use Arial everywhere (requires Arial to be installed / added via fontManager)
font.family      : sans-serif
font.sans-serif  : Arial

# Optional: make math text visually consistent with Arial
mathtext.fontset : custom
mathtext.rm      : Arial
mathtext.it      : Arial:italic
mathtext.bf      : Arial:bold

########################################
# Lines / plotting defaults (light touch)
########################################

lines.linewidth  : 1.2
lines.markersize : 4

########################################
# Grid
########################################

axes.grid        : True
grid.linestyle   : --
grid.linewidth   : 0.5
grid.alpha       : 0.3

########################################
# Save / export
########################################

path.simplify : True

# SVG: keep text as text objects (not paths)
svg.fonttype  : none
svg.hashsalt  : 42

# PDF/PS: embed TrueType fonts (Type 42) so Arial is preserved
pdf.fonttype  : 42
ps.fonttype   : 42
